rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Packages & destinations
    match /packages/{packageId} {
      allow read, write: if true;
    }
    
    match /destinations/{destId} {
      allow read, write: if true;
    }
    
    match /blogPosts/{blogId} {
      allow read, write: if true;
    }
    
    match /testimonials/{testId} {
      allow read, write: if true;
    }

    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // Leads & Enquiries
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Custom Trip Planner Requests (customTripRequests and customTours)
    match /customTripRequests/{tripId} {
      allow read, write: if true;
    }

    match /customTours/{tourId} {
      allow read, write: if true;
    }

    // General app settings & config
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Fallback for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

